{
  "conformanceVersion": "0.1.0",
  "description": "RFC 8785 (JCS) canonical JSON and SHA-256 conformance vectors.",
  "validVectors": [
    {
      "id": "jcs_primitives_and_neg_zero",
      "input": {
        "z": true,
        "a": 0,
        "m": null,
        "f": false,
        "s": "ensomi"
      },
      "expectedCanonicalJson": "{\"a\":0,\"f\":false,\"m\":null,\"s\":\"ensomi\",\"z\":true}",
      "expectedSha256Hex": "79b5cc89e7bb2acc4e2a50e87cd13a67335c30e6b9904e6434f5bf8fe2d3160b"
    },
    {
      "id": "jcs_utf16_code_unit_key_order_supplementary_vs_bmp",
      "input": {
        "": "bmp_private_use",
        "𐀀": "supplementary_u10000",
        "a": 1,
        "\r": "cr"
      },
      "expectedCanonicalJson": "{\"\\r\":\"cr\",\"a\":1,\"𐀀\":\"supplementary_u10000\",\"\":\"bmp_private_use\"}",
      "expectedSha256Hex": "2f29169a33511d9598932b82bb3a2be3d4fa26a011e1801dbe28f7e32d5958d9"
    },
    {
      "id": "jcs_ecmascript_number_formatting",
      "input": [
        1,
        1000000,
        0.000001,
        1e-7,
        100000000000000000000,
        1e+21,
        0.925
      ],
      "expectedCanonicalJson": "[1,1000000,0.000001,1e-7,100000000000000000000,1e+21,0.925]",
      "expectedSha256Hex": "2ef0e7df226f212212126c08d5d15d39daee14ce381d75aedecd2e311cd3e66c"
    },
    {
      "id": "jcs_control_escapes",
      "input": {
        "ctrl": "\u0000\b\t\n\f\r\u001f\"\\/"
      },
      "expectedCanonicalJson": "{\"ctrl\":\"\\u0000\\b\\t\\n\\f\\r\\u001f\\\"\\\\/\"}",
      "expectedSha256Hex": "c8d7d96aeefd1c13cb6fd464195cc5f38a2f801462a65f583f1b701d3e53303a"
    },
    {
      "id": "jcs_nested_microsecond_entities",
      "input": {
        "audioId": "track_01",
        "durationUs": 12000000,
        "beats": [
          {
            "id": "b_10",
            "atUs": 1000000
          },
          {
            "id": "b_2",
            "atUs": 500000
          }
        ],
        "residualUs": null
      },
      "expectedCanonicalJson": "{\"audioId\":\"track_01\",\"beats\":[{\"atUs\":1000000,\"id\":\"b_10\"},{\"atUs\":500000,\"id\":\"b_2\"}],\"durationUs\":12000000,\"residualUs\":null}",
      "expectedSha256Hex": "9929985d055a2c02675240a8f94a03d880d5365a584fdcd8d2825dcb196572e7"
    }
  ],
  "loneSurrogateHexCases": [
    {
      "id": "lone_high_surrogate",
      "utf16CodeUnitsHex": [
        "d800"
      ],
      "expectedErrorCode": "INVALID_CANONICAL_VALUE"
    },
    {
      "id": "lone_low_surrogate",
      "utf16CodeUnitsHex": [
        "0061",
        "dc00",
        "0062"
      ],
      "expectedErrorCode": "INVALID_CANONICAL_VALUE"
    }
  ]
}
