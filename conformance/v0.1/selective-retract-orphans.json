{
  "conformanceVersion": "0.1.0",
  "description": "Event-atomic selective retract rollback and nested redo conformance cases.",
  "cases": [
    {
      "id": "compound_edit_atomic_rollback_on_retracted_split",
      "events": [
        {
          "schemaVersion": "0.3",
          "seq": 0,
          "id": "o1_0",
          "type": "audio_bound",
          "author": {
            "kind": "host"
          },
          "payload": {
            "audioId": "orph_1",
            "durationUs": 12000000
          }
        },
        {
          "schemaVersion": "0.3",
          "seq": 1,
          "id": "o1_split",
          "type": "edit",
          "author": {
            "kind": "user"
          },
          "payload": {
            "op": "split_segment",
            "segmentId": "seg_audio_031c995c6526",
            "atUs": 6000000,
            "newBoundaryId": "bnd_mid",
            "newSegmentId": "seg_right"
          }
        },
        {
          "schemaVersion": "0.3",
          "seq": 2,
          "id": "o1_compound",
          "type": "edit",
          "author": {
            "kind": "user"
          },
          "payload": [
            {
              "op": "upsert_beat",
              "beat": {
                "id": "b_must_rollback",
                "atUs": 2000000
              }
            },
            {
              "op": "set_segment_keep",
              "segmentId": "seg_right",
              "keep": true
            }
          ]
        },
        {
          "schemaVersion": "0.3",
          "seq": 3,
          "id": "o1_retract_split",
          "type": "retract",
          "author": {
            "kind": "user"
          },
          "payload": {
            "targetEventId": "o1_split"
          }
        }
      ],
      "expectedSnapshotDigest": "d362e74ead98b774eb37581a2f3fef16501b4a06d3afc089ffa5ae5bb218dd23",
      "expectedOrphans": [
        {
          "eventId": "o1_compound",
          "code": "ORPHANED_BY_RETRACT",
          "causeCode": "MISSING_ENTITY"
        }
      ]
    },
