{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ensomi.dev/schemas/v0.1/trace-event.schema.json",
  "title": "Ensomi 0.1.0 Append-Only Trace Event and Snapshot",
  "description": "Single NDJSON (.jsonl) event envelope (schemaVersion 0.3) and JCS Snapshot.",
  "type": "object",
  "$ref": "#/$defs/TraceEvent",
  "$defs": {
    "TraceEventType": {
      "type": "string",
      "enum": [
        "audio_bound",
        "reset_document",
        "draft_loaded",
        "edit",
        "signal",
        "offer_batch",
        "offer_accept",
        "offer_reject",
        "retract",
        "listen_effort",
        "ready"
      ]
    },
    "AuthorKind": {
      "type": "string",
      "enum": ["user", "model", "rule", "host", "import"]
    },
    "TransactionOpKind": {
      "type": "string",
      "enum": [
        "upsert_beat",
        "move_beat",
        "snap_beat",
        "shift_beats",
        "remove_beats",
        "place_unbeat",
        "move_unbeat",
        "remove_unbeats",
        "beat_to_unbeat",
        "upsert_sound",
        "update_sound",
        "remove_sounds",
        "upsert_sound_class",
        "remove_sound_classes",
        "confirm_marks",
        "clear_verdicts",
        "split_segment",
        "merge_segments",
        "move_boundary",
        "promote_range_to_segments",
        "set_segment_regime",
        "set_segment_kinematics",
        "set_segment_keep",
        "set_range_regime",
        "set_range_keep"
      ]
    },
    "TransactionOp": {
      "type": "object",
      "required": ["op"],
      "properties": {
        "op": { "$ref": "#/$defs/TransactionOpKind" }
      },
      "oneOf": [
        {
          "required": ["op", "beat"],
          "properties": {
            "op": { "const": "upsert_beat" },
            "beat": { "$ref": "entities.schema.json#/$defs/BeatInput" },
            "tolUs": { "$ref": "entities.schema.json#/$defs/NonNegUs" },
            "via": { "$ref": "entities.schema.json#/$defs/VerdictVia" }
          },
          "additionalProperties": false
        },
        {
          "required": ["op", "id", "atUs"],
          "properties": {
            "op": { "const": "move_beat" },
            "id": { "type": "string", "minLength": 1 },
            "atUs": { "$ref": "entities.schema.json#/$defs/NonNegUs" },
            "tolUs": { "$ref": "entities.schema.json#/$defs/NonNegUs" },
            "via": { "$ref": "entities.schema.json#/$defs/VerdictVia" },
            "boundTo": {
              "oneOf": [
                { "type": "null" },
                { "$ref": "entities.schema.json#/$defs/BeatBinding" }
              ]
            },
            "structural": {
              "oneOf": [
                { "type": "null" },
                { "$ref": "entities.schema.json#/$defs/BeatStructural" }
              ]
            },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "additionalProperties": false
        },
        {
          "required": ["op", "id", "atUs", "boundTo"],
          "properties": {
            "op": { "const": "snap_beat" },
            "id": { "type": "string", "minLength": 1 },
            "atUs": { "$ref": "entities.schema.json#/$defs/NonNegUs" },
            "boundTo": { "$ref": "entities.schema.json#/$defs/BeatBinding" },
            "tolUs": { "$ref": "entities.schema.json#/$defs/NonNegUs" },
            "via": { "$ref": "entities.schema.json#/$defs/VerdictVia" },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "additionalProperties": false
        },
        {
          "required": ["op", "startUs", "endUs", "deltaUs"],
          "properties": {
            "op": { "const": "shift_beats" },
            "startUs": { "$ref": "entities.schema.json#/$defs/NonNegUs" },
            "endUs": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
            "deltaUs": { "type": "integer" },
            "includeVerified": { "type": "boolean", "default": false }
          },
          "additionalProperties": false
        },
        {
          "required": ["op", "ids"],
          "properties": {
            "op": { "const": "remove_beats" },
            "ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          },
          "additionalProperties": false
        },
        {
          "required": ["op", "id", "atUs"],
          "properties": {
            "op": { "const": "place_unbeat" },
            "id": { "type": "string", "minLength": 1 },
            "atUs": { "$ref": "entities.schema.json#/$defs/NonNegUs" },
            "tolUs": { "$ref": "entities.schema.json#/$defs/NonNegUs" },
            "pulseLayer": { "$ref": "entities.schema.json#/$defs/PulseLayer" },
            "captureUnverifiedRadiusUs": { "$ref": "entities.schema.json#/$defs/NonNegUs" },
            "removeVerifiedBeatIds": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "via": { "$ref": "entities.schema.json#/$defs/VerdictVia" }
          },
          "additionalProperties": false
        },
        {
          "required": ["op", "id", "atUs"],
          "properties": {
            "op": { "const": "move_unbeat" },
            "id": { "type": "string", "minLength": 1 },
            "atUs": { "$ref": "entities.schema.json#/$defs/NonNegUs" },
            "tolUs": { "$ref": "entities.schema.json#/$defs/NonNegUs" },
            "pulseLayer": { "$ref": "entities.schema.json#/$defs/PulseLayer" },
            "via": { "$ref": "entities.schema.json#/$defs/VerdictVia" }
          },
          "additionalProperties": false
        },
        {
          "required": ["op", "ids"],
          "properties": {
            "op": { "const": "remove_unbeats" },
            "ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          },
          "additionalProperties": false
        },
        {
          "required": ["op", "conversions"],
          "properties": {
            "op": { "const": "beat_to_unbeat" },
            "conversions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["beatId", "expectedRevision", "newUnbeatId"],
                "properties": {
                  "beatId": { "type": "string", "minLength": 1 },
                  "expectedRevision": { "type": "integer", "minimum": 1 },
                  "newUnbeatId": { "type": "string", "minLength": 1 },
                  "tolUs": { "$ref": "entities.schema.json#/$defs/NonNegUs" },
                  "pulseLayer": { "$ref": "entities.schema.json#/$defs/PulseLayer" }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        {
          "required": ["op", "sound"],
          "properties": {
            "op": { "const": "upsert_sound" },
            "sound": { "$ref": "entities.schema.json#/$defs/SoundInput" },
            "tolUs": { "$ref": "entities.schema.json#/$defs/NonNegUs" },
            "facet": { "type": "string", "minLength": 1 },
            "via": { "$ref": "entities.schema.json#/$defs/VerdictVia" }
          },
          "additionalProperties": false
        },
        {
          "required": ["op", "id", "patch"],
          "properties": {
            "op": { "const": "update_sound" },
            "id": { "type": "string", "minLength": 1 },
            "patch": { "$ref": "entities.schema.json#/$defs/SoundPatch" },
            "tolUs": { "$ref": "entities.schema.json#/$defs/NonNegUs" },
            "facet": { "type": "string", "minLength": 1 },
            "via": { "$ref": "entities.schema.json#/$defs/VerdictVia" }
          },
          "additionalProperties": false
        },
        {
          "required": ["op", "ids"],
          "properties": {
            "op": { "const": "remove_sounds" },
            "ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          },
          "additionalProperties": false
        },
        {
          "required": ["op", "soundClass"],
          "properties": {
            "op": { "const": "upsert_sound_class" },
            "soundClass": { "$ref": "entities.schema.json#/$defs/SoundClassInput" },
            "tolUs": { "$ref": "entities.schema.json#/$defs/NonNegUs" },
            "via": { "$ref": "entities.schema.json#/$defs/VerdictVia" }
          },
          "additionalProperties": false
        },
        {
          "required": ["op", "ids"],
          "properties": {
            "op": { "const": "remove_sound_classes" },
            "ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          },
          "additionalProperties": false
        },
        {
          "required": ["op", "targets"],
          "properties": {
            "op": { "const": "confirm_marks" },
            "targets": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["kind", "id", "expectedRevision"],
                "properties": {
                  "kind": { "$ref": "entities.schema.json#/$defs/VerdictTargetKind" },
                  "id": { "type": "string", "minLength": 1 },
                  "expectedRevision": { "type": "integer", "minimum": 1 },
                  "facet": { "type": "string", "minLength": 1 }
                },
                "additionalProperties": false
              }
            },
            "tolUs": { "$ref": "entities.schema.json#/$defs/NonNegUs" },
            "via": { "type": "string", "enum": ["review", "tap"] }
          },
          "additionalProperties": false
        },
        {
          "required": ["op", "targets"],
          "properties": {
            "op": { "const": "clear_verdicts" },
            "targets": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["kind", "id", "expectedRevision"],
                "properties": {
                  "kind": { "$ref": "entities.schema.json#/$defs/VerdictTargetKind" },
                  "id": { "type": "string", "minLength": 1 },
                  "expectedRevision": { "type": "integer", "minimum": 1 }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        {
          "required": ["op", "segmentId", "atUs"],
          "properties": {
            "op": { "const": "split_segment" },
            "segmentId": { "type": "string", "minLength": 1 },
            "atUs": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
            "newBoundaryId": { "type": "string", "minLength": 1 },
            "newSegmentId": { "type": "string", "minLength": 1 },
            "rightRegime": { "$ref": "entities.schema.json#/$defs/SegmentRegime" },
            "rightKinematics": { "$ref": "entities.schema.json#/$defs/SegmentKinematics" }
          },
          "additionalProperties": false
        },
        {
          "required": ["op", "leftSegmentId", "rightSegmentId"],
          "properties": {
            "op": { "const": "merge_segments" },
            "leftSegmentId": { "type": "string", "minLength": 1 },
            "rightSegmentId": { "type": "string", "minLength": 1 },
            "mergedRegime": { "$ref": "entities.schema.json#/$defs/SegmentRegime" },
            "mergedKinematics": {
              "oneOf": [
                { "type": "null" },
                { "$ref": "entities.schema.json#/$defs/SegmentKinematics" }
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "required": ["op", "boundaryId", "atUs"],
          "properties": {
            "op": { "const": "move_boundary" },
            "boundaryId": { "type": "string", "minLength": 1 },
            "atUs": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
            "tolUs": { "$ref": "entities.schema.json#/$defs/NonNegUs" },
            "via": { "$ref": "entities.schema.json#/$defs/VerdictVia" }
          },
          "additionalProperties": false
        },
        {
          "required": ["op", "startUs", "endUs"],
          "properties": {
            "op": { "const": "promote_range_to_segments" },
            "startUs": { "$ref": "entities.schema.json#/$defs/NonNegUs" },
            "endUs": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
            "newBoundaryIds": { "$ref": "entities.schema.json#/$defs/NormalizedIdPair" },
            "newSegmentIds": { "$ref": "entities.schema.json#/$defs/NormalizedIdPair" },
            "regime": { "$ref": "entities.schema.json#/$defs/SegmentRegime" },
            "kinematics": { "$ref": "entities.schema.json#/$defs/SegmentKinematics" },
            "keep": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        {
          "required": ["op", "segmentId", "regime"],
          "properties": {
            "op": { "const": "set_segment_regime" },
            "segmentId": { "type": "string", "minLength": 1 },
            "regime": { "$ref": "entities.schema.json#/$defs/SegmentRegime" }
          },
          "additionalProperties": false
        },
        {
          "required": ["op", "segmentId", "kinematics"],
          "properties": {
            "op": { "const": "set_segment_kinematics" },
            "segmentId": { "type": "string", "minLength": 1 },
            "kinematics": {
              "oneOf": [
                { "type": "null" },
                { "$ref": "entities.schema.json#/$defs/SegmentKinematics" }
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "required": ["op", "segmentId", "keep"],
          "properties": {
            "op": { "const": "set_segment_keep" },
            "segmentId": { "type": "string", "minLength": 1 },
            "keep": { "type": "boolean" },
            "approvalId": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        {
          "required": ["op", "startUs", "endUs", "regime"],
          "properties": {
            "op": { "const": "set_range_regime" },
            "startUs": { "$ref": "entities.schema.json#/$defs/NonNegUs" },
            "endUs": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
            "regime": { "type": "string", "enum": ["auto", "free"] }
          },
          "additionalProperties": false
        },
        {
          "required": ["op", "startUs", "endUs", "keep"],
          "properties": {
            "op": { "const": "set_range_keep" },
            "startUs": { "$ref": "entities.schema.json#/$defs/NonNegUs" },
            "endUs": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
            "keep": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      ]
    },
    "EditPayload": {
      "oneOf": [
        { "$ref": "#/$defs/TransactionOp" },
        {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/TransactionOp" }
        },
        {
          "type": "object",
          "required": ["ops"],
          "properties": {
            "ops": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/TransactionOp" }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "RejectionSuppression": {
      "type": "object",
      "required": ["semanticKey", "writeRanges", "rejectedAtSeq", "offerId"],
      "properties": {
        "semanticKey": { "type": "string", "minLength": 1 },
        "writeRanges": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "entities.schema.json#/$defs/RangeUs" }
        },
        "rejectedAtSeq": { "type": "integer", "minimum": 0 },
        "offerId": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "SignalPayload": {
      "type": "object",
      "required": ["layer", "scope", "reason", "generation"],
      "properties": {
        "layer": { "const": "heavy_recompute" },
        "scope": {
          "oneOf": [
            { "const": "song" },
            { "$ref": "entities.schema.json#/$defs/RangeUs" }
          ]
        },
        "reason": { "type": "string", "minLength": 1 },
        "generation": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "TraceEvent": {
      "type": "object",
      "required": ["schemaVersion", "seq", "id", "type", "author", "payload"],
      "properties": {
        "schemaVersion": { "const": "0.3" },
        "seq": { "type": "integer", "minimum": 0 },
        "id": { "type": "string", "minLength": 1 },
        "type": { "$ref": "#/$defs/TraceEventType" },
        "tsMs": { "type": "number" },
        "author": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "$ref": "#/$defs/AuthorKind" },
            "id": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "payload": {}
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "edit" } },
            "required": ["type"]
          },
          "then": {
            "properties": { "payload": { "$ref": "#/$defs/EditPayload" } }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "offer_batch" } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "required": ["offers"],
                "properties": {
                  "batchId": { "type": "string", "minLength": 1 },
                  "offers": {
                    "type": "array",
                    "items": { "$ref": "offer.schema.json#/$defs/Offer" }
                  },
                  "waitUs": { "$ref": "entities.schema.json#/$defs/NonNegUs" }
                },
                "additionalProperties": false
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "OrphanedTransaction": {
      "type": "object",
      "required": ["seq", "eventId", "type", "code", "causeCode", "message"],
      "properties": {
        "seq": { "type": "integer", "minimum": 0 },
        "eventId": { "type": "string", "minLength": 1 },
        "type": { "$ref": "#/$defs/TraceEventType" },
        "code": { "const": "ORPHANED_BY_RETRACT" },
        "causeCode": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "Snapshot": {
      "type": "object",
      "required": [
        "schemaVersion",
        "audio",
        "durationUs",
        "segments",
        "boundaries",
        "spans",
        "beats",
        "unbeats",
        "sounds",
        "soundClasses",
        "approvals",
        "retiredEntityIds",
        "offers",
        "suppressions",
        "orphanedTransactions",
        "lastSignal",
        "generation",
        "effort",
        "visitedRanges",
        "ready",
        "readyAtSeq",
        "retractedEventIds",
        "lastSeq"
      ],
      "properties": {
        "schemaVersion": { "const": "0.3" },
        "audio": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "entities.schema.json#/$defs/AudioBinding" }
          ]
        },
        "durationUs": { "$ref": "entities.schema.json#/$defs/NonNegUs" },
        "segments": { "type": "array", "items": { "$ref": "entities.schema.json#/$defs/Segment" } },
        "boundaries": { "type": "array", "items": { "$ref": "entities.schema.json#/$defs/Boundary" } },
        "spans": { "type": "array", "items": { "$ref": "entities.schema.json#/$defs/Span" } },
        "beats": { "type": "array", "items": { "$ref": "entities.schema.json#/$defs/Beat" } },
        "unbeats": { "type": "array", "items": { "$ref": "entities.schema.json#/$defs/Unbeat" } },
        "sounds": { "type": "array", "items": { "$ref": "entities.schema.json#/$defs/Sound" } },
        "soundClasses": { "type": "array", "items": { "$ref": "entities.schema.json#/$defs/SoundClass" } },
        "approvals": { "type": "array", "items": { "$ref": "entities.schema.json#/$defs/Approval" } },
        "retiredEntityIds": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "kind", "createdByEventId", "retiredByEventId"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "kind": { "$ref": "entities.schema.json#/$defs/EntityKind" },
              "createdByEventId": { "type": "string", "minLength": 1 },
              "retiredByEventId": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "offers": { "type": "array", "items": { "$ref": "offer.schema.json#/$defs/Offer" } },
        "suppressions": { "type": "array", "items": { "$ref": "#/$defs/RejectionSuppression" } },
        "orphanedTransactions": { "type": "array", "items": { "$ref": "#/$defs/OrphanedTransaction" } },
        "lastSignal": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/SignalPayload" }
          ]
        },
        "generation": { "type": "integer", "minimum": 0 },
        "effort": {
          "type": "object",
          "required": ["listenUs", "waitUs", "actionCount"],
          "properties": {
            "listenUs": { "$ref": "entities.schema.json#/$defs/NonNegUs" },
            "waitUs": { "$ref": "entities.schema.json#/$defs/NonNegUs" },
            "actionCount": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "visitedRanges": { "type": "array", "items": { "$ref": "entities.schema.json#/$defs/RangeUs" } },
        "ready": { "type": "boolean" },
        "readyAtSeq": { "type": ["integer", "null"] },
        "retractedEventIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "lastSeq": { "type": "integer", "minimum": -1 }
      },
      "additionalProperties": false
    }
  }
}
