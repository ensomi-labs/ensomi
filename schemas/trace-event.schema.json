{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ensomi.dev/schemas/v0/trace-event.schema.json",
  "title": "Ensomi v0 Append-Only Trace Event",
  "description": "Single NDJSON (.jsonl) event envelope for Ensomi v0 traces.",
  "type": "object",
  "required": ["schemaVersion", "seq", "id", "type", "author", "payload"],
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": [
        "audio_bound",
        "draft_loaded",
        "edit",
        "statement",
        "signal",
        "offer_batch",
        "offer_accept",
        "offer_reject",
        "retract",
        "listen_effort",
        "ready"
      ]
    },
    "tsMs": {
      "type": "number"
    },
    "author": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["user", "model", "rule", "host", "import"]
        },
        "id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "payload": {}
  },
  "additionalProperties": false
}
