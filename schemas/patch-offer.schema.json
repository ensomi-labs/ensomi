{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ensomi.dev/schemas/tempo/patch-offer.schema.json",
  "title": "Ensomi Tempo Contract PatchOffer and Validation",
  "type": "object",
  "$ref": "#/$defs/PatchOffer",
  "$defs": {
    "OfferScopeKind": {
      "type": "string",
      "enum": ["local", "forward", "cross_region"]
    },
    "OfferStatus": {
      "type": "string",
      "enum": ["valid", "stale", "invalid", "accepted", "rejected", "superseded"]
    },
    "ConflictKind": {
      "type": "string",
      "enum": [
        "protected_keep",
        "version_mismatch",
        "range_changed",
        "out_of_scope",
        "sibling_conflict"
      ]
    },
    "WriteScope": {
      "type": "object",
      "required": ["segmentId", "t0", "t1"],
      "properties": {
        "segmentId": { "type": "string", "minLength": 1 },
        "t0": { "type": "number", "minimum": 0 },
        "t1": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "OfferConflict": {
      "type": "object",
      "required": ["kind", "message"],
      "properties": {
        "kind": { "$ref": "#/$defs/ConflictKind" },
        "message": { "type": "string", "minLength": 1 },
        "t0": { "type": "number", "minimum": 0 },
        "t1": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "PatchOp": {
      "type": "object",
      "properties": {
        "upsertBeats": {
          "type": "array",
          "items": { "type": "object" }
        },
        "removeBeatIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "upsertSounds": {
          "type": "array",
          "items": { "type": "object" }
        },
        "removeSoundIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "splitSegments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["segmentId", "newSegmentId", "timeSec"],
            "properties": {
              "segmentId": { "type": "string", "minLength": 1 },
              "newSegmentId": { "type": "string", "minLength": 1 },
              "timeSec": { "type": "number", "minimum": 0 }
            },
            "additionalProperties": false
          }
        },
        "moveSegmentBoundaries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["leftSegmentId", "rightSegmentId", "timeSec"],
            "properties": {
              "leftSegmentId": { "type": "string", "minLength": 1 },
              "rightSegmentId": { "type": "string", "minLength": 1 },
              "timeSec": { "type": "number", "minimum": 0 }
            },
            "additionalProperties": false
          }
        },
        "setSegmentRegimes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["segmentId", "regime"],
            "properties": {
              "segmentId": { "type": "string", "minLength": 1 },
              "regime": { "$ref": "entities.schema.json#/$defs/SegmentRegime" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "OfferConsequences": {
      "type": "object",
      "required": ["beatsAdded", "beatsMoved", "beatsRemoved", "maxShiftMs", "segmentChanges"],
      "properties": {
        "beatsAdded": { "type": "integer", "minimum": 0 },
        "beatsMoved": { "type": "integer", "minimum": 0 },
        "beatsRemoved": { "type": "integer", "minimum": 0 },
        "maxShiftMs": { "type": "number", "minimum": 0 },
        "segmentChanges": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "PatchOffer": {
      "type": "object",
      "required": [
        "id",
        "batchId",
        "semanticKey",
        "providerId",
        "providerKind",
        "generation",
        "basisSeq",
        "expectedRevisions",
        "writeScopes",
        "scopeKind",
        "title",
        "consequenceSummary",
        "advisoryNotes",
        "ops",
        "consequences",
        "conflicts",
        "status"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "batchId": { "type": "string", "minLength": 1 },
        "semanticKey": { "type": "string", "minLength": 1 },
        "providerId": { "type": "string", "minLength": 1 },
        "providerKind": { "type": "string", "enum": ["model", "rule", "mock"] },
        "generation": { "type": "integer", "minimum": 0 },
        "basisSeq": { "type": "integer", "minimum": 0 },
        "expectedRevisions": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "expectedScopeBeatIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "writeScopes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/WriteScope" }
        },
        "readScope": {
          "oneOf": [
            { "const": "song" },
            { "$ref": "entities.schema.json#/$defs/Range" }
          ]
        },
        "scopeKind": { "$ref": "#/$defs/OfferScopeKind" },
        "optionIndex": { "type": "integer", "minimum": 0 },
        "optionCount": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1 },
        "consequenceSummary": { "type": "string", "minLength": 1 },
        "advisoryNotes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "providerAdvisories": {
          "type": "array",
          "items": { "type": "string" }
        },
        "ops": { "$ref": "#/$defs/PatchOp" },
        "consequences": { "$ref": "#/$defs/OfferConsequences" },
        "conflicts": {
          "type": "array",
          "items": { "$ref": "#/$defs/OfferConflict" }
        },
        "status": { "$ref": "#/$defs/OfferStatus" }
      },
      "additionalProperties": false
    }
  }
}
