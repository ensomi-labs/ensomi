{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ensomi.dev/schemas/v0.1/offer.schema.json",
  "title": "Ensomi 0.1.0 Offer, Dependencies, and Challenges",
  "type": "object",
  "$ref": "#/$defs/Offer",
  "$defs": {
    "OfferKind": {
      "type": "string",
      "enum": ["pulse", "segmentation", "sound_match", "propagation"]
    },
    "OfferStatus": {
      "type": "string",
      "enum": [
        "valid",
        "requires_challenge_confirm",
        "stale",
        "invalid",
        "accepted",
        "rejected",
        "superseded"
      ]
    },
    "ConflictKind": {
      "type": "string",
      "enum": [
        "protected_keep",
        "protected_verified",
        "authority_violation",
        "version_mismatch",
        "range_changed",
        "policy_changed",
        "source_changed",
        "out_of_scope",
        "invalid_op",
        "sibling_conflict"
      ]
    },
    "ChallengeDisposition": {
      "type": "string",
      "enum": ["confirm_replacement", "clear_verdict"]
    },
    "OfferOpKind": {
      "type": "string",
      "enum": [
        "upsert_beat",
        "move_beat",
        "snap_beat",
        "shift_beats",
        "remove_beats",
        "remove_unbeats",
        "upsert_sound",
        "update_sound",
        "remove_sounds",
        "upsert_sound_class",
        "remove_sound_classes",
        "split_segment",
        "merge_segments",
        "move_boundary",
        "promote_range_to_segments",
        "set_segment_regime",
        "set_segment_kinematics",
        "set_range_regime"
      ]
    },
    "OfferOp": {
      "type": "object",
      "required": ["op"],
      "properties": {
        "op": { "$ref": "#/$defs/OfferOpKind" }
      },
      "oneOf": [
        {
          "required": ["op", "beat"],
          "properties": {
            "op": { "const": "upsert_beat" },
            "beat": { "$ref": "entities.schema.json#/$defs/BeatInput" }
          },
          "additionalProperties": false
        },
        {
          "required": ["op", "id", "atUs"],
          "properties": {
            "op": { "const": "move_beat" },
            "id": { "type": "string", "minLength": 1 },
            "atUs": { "$ref": "entities.schema.json#/$defs/NonNegUs" },
            "boundTo": {
              "oneOf": [
                { "type": "null" },
                { "$ref": "entities.schema.json#/$defs/BeatBinding" }
              ]
            },
            "structural": {
              "oneOf": [
                { "type": "null" },
                { "$ref": "entities.schema.json#/$defs/BeatStructural" }
              ]
            },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "additionalProperties": false
        },
        {
          "required": ["op", "id", "atUs", "boundTo"],
          "properties": {
            "op": { "const": "snap_beat" },
            "id": { "type": "string", "minLength": 1 },
            "atUs": { "$ref": "entities.schema.json#/$defs/NonNegUs" },
            "boundTo": { "$ref": "entities.schema.json#/$defs/BeatBinding" },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "additionalProperties": false
        },
        {
          "required": ["op", "startUs", "endUs", "deltaUs"],
          "properties": {
            "op": { "const": "shift_beats" },
            "startUs": { "$ref": "entities.schema.json#/$defs/NonNegUs" },
            "endUs": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
            "deltaUs": { "type": "integer" },
            "includeVerified": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        {
          "required": ["op", "ids"],
          "properties": {
            "op": { "const": "remove_beats" },
            "ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          },
          "additionalProperties": false
        },
        {
          "required": ["op", "ids"],
          "properties": {
            "op": { "const": "remove_unbeats" },
            "ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          },
          "additionalProperties": false
        },
        {
          "required": ["op", "sound"],
          "properties": {
            "op": { "const": "upsert_sound" },
            "sound": { "$ref": "entities.schema.json#/$defs/SoundInput" }
          },
          "additionalProperties": false
        },
        {
          "required": ["op", "id", "patch"],
          "properties": {
            "op": { "const": "update_sound" },
            "id": { "type": "string", "minLength": 1 },
            "patch": { "$ref": "entities.schema.json#/$defs/SoundPatch" }
          },
          "additionalProperties": false
        },
        {
          "required": ["op", "ids"],
          "properties": {
            "op": { "const": "remove_sounds" },
            "ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          },
          "additionalProperties": false
        },
        {
          "required": ["op", "soundClass"],
          "properties": {
            "op": { "const": "upsert_sound_class" },
            "soundClass": { "$ref": "entities.schema.json#/$defs/SoundClassInput" }
          },
          "additionalProperties": false
        },
        {
          "required": ["op", "ids"],
          "properties": {
            "op": { "const": "remove_sound_classes" },
            "ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          },
          "additionalProperties": false
        },
        {
          "required": ["op", "segmentId", "atUs"],
          "properties": {
            "op": { "const": "split_segment" },
            "segmentId": { "type": "string", "minLength": 1 },
            "atUs": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
            "newBoundaryId": { "type": "string", "minLength": 1 },
            "newSegmentId": { "type": "string", "minLength": 1 },
            "rightRegime": { "$ref": "entities.schema.json#/$defs/SegmentRegime" },
            "rightKinematics": { "$ref": "entities.schema.json#/$defs/SegmentKinematics" }
          },
          "additionalProperties": false
        },
        {
          "required": ["op", "leftSegmentId", "rightSegmentId"],
          "properties": {
            "op": { "const": "merge_segments" },
            "leftSegmentId": { "type": "string", "minLength": 1 },
            "rightSegmentId": { "type": "string", "minLength": 1 },
            "mergedRegime": { "$ref": "entities.schema.json#/$defs/SegmentRegime" },
            "mergedKinematics": {
              "oneOf": [
                { "type": "null" },
                { "$ref": "entities.schema.json#/$defs/SegmentKinematics" }
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "required": ["op", "boundaryId", "atUs"],
          "properties": {
            "op": { "const": "move_boundary" },
            "boundaryId": { "type": "string", "minLength": 1 },
            "atUs": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
          },
          "additionalProperties": false
        },
        {
          "required": ["op", "startUs", "endUs"],
          "properties": {
            "op": { "const": "promote_range_to_segments" },
            "startUs": { "$ref": "entities.schema.json#/$defs/NonNegUs" },
            "endUs": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
            "newBoundaryIds": { "$ref": "entities.schema.json#/$defs/NormalizedIdPair" },
            "newSegmentIds": { "$ref": "entities.schema.json#/$defs/NormalizedIdPair" },
            "regime": { "$ref": "entities.schema.json#/$defs/SegmentRegime" },
            "kinematics": { "$ref": "entities.schema.json#/$defs/SegmentKinematics" }
          },
          "additionalProperties": false
        },
        {
          "required": ["op", "segmentId", "regime"],
          "properties": {
            "op": { "const": "set_segment_regime" },
            "segmentId": { "type": "string", "minLength": 1 },
            "regime": { "$ref": "entities.schema.json#/$defs/SegmentRegime" }
          },
          "additionalProperties": false
        },
        {
          "required": ["op", "segmentId", "kinematics"],
          "properties": {
            "op": { "const": "set_segment_kinematics" },
            "segmentId": { "type": "string", "minLength": 1 },
            "kinematics": {
              "oneOf": [
                { "type": "null" },
                { "$ref": "entities.schema.json#/$defs/SegmentKinematics" }
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "required": ["op", "startUs", "endUs", "regime"],
          "properties": {
            "op": { "const": "set_range_regime" },
            "startUs": { "$ref": "entities.schema.json#/$defs/NonNegUs" },
            "endUs": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
            "regime": { "type": "string", "enum": ["auto", "free"] }
          },
          "additionalProperties": false
        }
      ]
    },
    "OfferDependencies": {
      "type": "object",
      "required": [
        "audioId",
        "durationUs",
        "writeRanges",
        "segments",
        "boundaries",
        "spans",
        "beats",
        "unbeats",
        "sounds",
        "soundClasses"
      ],
      "properties": {
        "audioId": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1 }
          ]
        },
        "durationUs": { "$ref": "entities.schema.json#/$defs/NonNegUs" },
        "writeRanges": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "entities.schema.json#/$defs/RangeUs" }
        },
        "segments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "startUs", "endUs", "regime", "kinematics", "revision", "approved"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "startUs": { "$ref": "entities.schema.json#/$defs/NonNegUs" },
              "endUs": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
              "regime": { "$ref": "entities.schema.json#/$defs/SegmentRegime" },
              "kinematics": {
                "oneOf": [
                  { "type": "null" },
                  { "$ref": "entities.schema.json#/$defs/SegmentKinematics" }
                ]
              },
              "revision": { "type": "integer", "minimum": 1 },
              "approved": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        },
        "boundaries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "atUs", "revision"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "atUs": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
              "revision": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          }
        },
        "spans": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "segmentId", "startUs", "endUs", "kind", "revision", "approved"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "segmentId": { "type": "string", "minLength": 1 },
              "startUs": { "$ref": "entities.schema.json#/$defs/NonNegUs" },
              "endUs": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
              "kind": { "$ref": "entities.schema.json#/$defs/SpanKind" },
              "revision": { "type": "integer", "minimum": 1 },
              "approved": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        },
        "beats": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "atUs", "revision"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "atUs": { "$ref": "entities.schema.json#/$defs/NonNegUs" },
              "revision": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          }
        },
        "unbeats": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "atUs", "revision"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "atUs": { "$ref": "entities.schema.json#/$defs/NonNegUs" },
              "revision": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          }
        },
        "sounds": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "startUs", "endUs", "revision"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "startUs": { "$ref": "entities.schema.json#/$defs/NonNegUs" },
              "endUs": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
              "revision": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          }
        },
        "soundClasses": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "revision"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "revision": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          }
        },
        "derivedFrom": {
          "type": "object",
          "required": ["range", "sourceDigest", "supportingRevisions"],
          "properties": {
            "range": { "$ref": "entities.schema.json#/$defs/RangeUs" },
            "sourceDigest": { "type": "string", "minLength": 1 },
            "supportingRevisions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "kind", "revision", "valueDigest"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "kind": { "$ref": "entities.schema.json#/$defs/EntityKind" },
                  "revision": { "type": "integer", "minimum": 0 },
                  "valueDigest": { "type": "string", "minLength": 1 }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "OfferConflict": {
      "type": "object",
      "required": ["kind", "message"],
      "properties": {
        "kind": { "$ref": "#/$defs/ConflictKind" },
        "message": { "type": "string", "minLength": 1 },
        "startUs": { "$ref": "entities.schema.json#/$defs/NonNegUs" },
        "endUs": { "$ref": "entities.schema.json#/$defs/NonNegUs" },
        "targetKind": { "$ref": "entities.schema.json#/$defs/VerdictTargetKind" },
        "targetId": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "OfferChallenge": {
      "type": "object",
      "required": ["challengeId", "targetKind", "targetId", "expectedRevision", "expectedValueDigest", "reasonCode"],
      "properties": {
        "challengeId": { "type": "string", "minLength": 1 },
        "targetKind": { "$ref": "entities.schema.json#/$defs/VerdictTargetKind" },
        "targetId": { "type": "string", "minLength": 1 },
        "expectedRevision": { "type": "integer", "minimum": 1 },
        "expectedValueDigest": { "type": "string", "minLength": 1 },
        "reasonCode": { "type": "string", "minLength": 1 },
        "replacementId": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "Offer": {
      "type": "object",
      "required": [
        "id",
        "batchId",
        "kind",
        "providerId",
        "audioId",
        "basisSeq",
        "writeRanges",
        "dependencies",
        "basisDigest",
        "ops",
        "notes",
        "status",
        "conflicts"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "batchId": { "type": "string", "minLength": 1 },
        "alternativeGroup": { "type": "string", "minLength": 1 },
        "kind": { "$ref": "#/$defs/OfferKind" },
        "providerId": { "type": "string", "minLength": 1 },
        "modelRevision": { "type": "string", "minLength": 1 },
        "audioId": { "type": "string", "minLength": 1 },
        "basisSeq": { "type": "integer", "minimum": -1 },
        "writeRanges": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "entities.schema.json#/$defs/RangeUs" }
        },
        "dependencies": { "$ref": "#/$defs/OfferDependencies" },
        "basisDigest": { "type": "string", "minLength": 1 },
        "ops": { "type": "array", "items": { "$ref": "#/$defs/OfferOp" } },
        "challenges": { "type": "array", "items": { "$ref": "#/$defs/OfferChallenge" } },
        "derivedFrom": {
          "type": "object",
          "required": ["range", "sourceDigest", "supportingIds"],
          "properties": {
            "range": { "$ref": "entities.schema.json#/$defs/RangeUs" },
            "sourceDigest": { "type": "string", "minLength": 1 },
            "supportingIds": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          },
          "additionalProperties": false
        },
        "notes": {
          "type": "array",
          "items": { "$ref": "entities.schema.json#/$defs/StructuredNote" }
        },
        "title": { "type": "string", "minLength": 1 },
        "optionIndex": { "type": "integer", "minimum": 0 },
        "optionCount": { "type": "integer", "minimum": 1 },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "semanticKey": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/OfferStatus" },
        "conflicts": { "type": "array", "items": { "$ref": "#/$defs/OfferConflict" } }
      },
      "additionalProperties": false
    }
  }
}
