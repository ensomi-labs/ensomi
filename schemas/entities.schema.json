{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ensomi.dev/schemas/v0.1/entities.schema.json",
  "title": "Ensomi 0.1.0 Core Entities",
  "description": "Integer-microsecond epistemic entities for Ensomi.",
  "$defs": {
    "NonNegUs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "Origin": {
      "type": "string",
      "enum": ["import", "model", "rule", "user"]
    },
    "VerdictKind": {
      "type": "string",
      "enum": ["placed", "adjusted", "confirmed"]
    },
    "VerdictVia": {
      "type": "string",
      "enum": ["tap", "snap", "nudge", "review", "challenge_accept"]
    },
    "EntityKind": {
      "type": "string",
      "enum": ["beat", "unbeat", "sound", "sound_class", "boundary", "segment", "span", "approval"]
    },
    "VerdictTargetKind": {
      "type": "string",
      "enum": ["beat", "unbeat", "sound", "sound_class", "boundary"]
    },
    "SegmentRegime": {
      "type": "string",
      "enum": ["auto", "free", "break"]
    },
    "SegmentKinematics": {
      "type": "string",
      "enum": ["steady", "ramp", "rubato", "unknown"]
    },
    "SpanKind": {
      "type": "string",
      "enum": ["free", "keep"]
    },
    "InboxPriority": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "SnapRole": {
      "type": "string",
      "enum": ["transient_attack", "p_center", "harmonic_change", "release"]
    },
    "SoundRegister": {
      "type": "string",
      "enum": ["sub", "low", "mid", "high"]
    },
    "SoundEndKind": {
      "type": "string",
      "enum": ["observed", "estimated", "right_censored"]
    },
    "SoundBlendStatus": {
      "type": "string",
      "enum": ["isolated", "blended"]
    },
    "SoundMatchMode": {
      "type": "string",
      "enum": ["hit", "voice", "figure"]
    },
    "PulseLayer": {
      "type": "string",
      "enum": ["tactus", "subdivision", "any"]
    },
    "BeatAnchorKind": {
      "type": "string",
      "enum": ["anchored", "interpolated"]
    },
    "RangeUs": {
      "type": "object",
      "required": ["startUs", "endUs"],
      "properties": {
        "startUs": { "$ref": "#/$defs/NonNegUs" },
        "endUs": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      },
      "additionalProperties": false
    },
    "StructuredNote": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "params": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "boolean", "null"]
          }
        }
      },
      "additionalProperties": false
    },
    "Verdict": {
      "type": "object",
      "required": ["kind", "eventId", "valueDigest", "tolUs"],
      "properties": {
        "kind": { "$ref": "#/$defs/VerdictKind" },
        "eventId": { "type": "string", "minLength": 1 },
        "valueDigest": { "type": "string", "minLength": 1 },
        "tolUs": { "$ref": "#/$defs/NonNegUs" },
        "facet": { "type": "string", "minLength": 1 },
        "via": { "$ref": "#/$defs/VerdictVia" }
      },
      "additionalProperties": false
    },
    "Approval": {
      "type": "object",
      "required": ["id", "eventId", "contentDigest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "eventId": { "type": "string", "minLength": 1 },
        "contentDigest": { "type": "string", "minLength": 1 },
        "modifiedSinceApproval": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "AudioBinding": {
      "type": "object",
      "required": ["audioId", "durationUs"],
      "properties": {
        "audioId": { "type": "string", "minLength": 1 },
        "durationUs": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "sampleRateHz": { "type": "number", "exclusiveMinimum": 0 },
        "sampleCount": { "$ref": "#/$defs/NonNegUs" },
        "audioSha256": { "type": "string", "minLength": 1 },
        "decodedPcmSha256": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "Boundary": {
      "type": "object",
      "required": ["id", "atUs", "origin", "createdByEventId", "revision"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "atUs": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "origin": { "$ref": "#/$defs/Origin" },
        "createdByEventId": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 1 },
        "verdict": { "$ref": "#/$defs/Verdict" }
      },
      "additionalProperties": false
    },
    "Segment": {
      "type": "object",
      "required": ["id", "startUs", "endUs", "startBoundaryId", "endBoundaryId", "regime", "origin", "createdByEventId", "revision"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "startUs": { "$ref": "#/$defs/NonNegUs" },
        "endUs": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "startBoundaryId": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1 }
          ]
        },
        "endBoundaryId": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1 }
          ]
        },
        "regime": { "$ref": "#/$defs/SegmentRegime" },
        "kinematics": { "$ref": "#/$defs/SegmentKinematics" },
        "origin": { "$ref": "#/$defs/Origin" },
        "createdByEventId": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 1 },
        "approval": { "$ref": "#/$defs/Approval" }
      },
      "additionalProperties": false
    },
    "Span": {
      "type": "object",
      "required": ["id", "segmentId", "startUs", "endUs", "kind", "origin", "createdByEventId", "revision"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "segmentId": { "type": "string", "minLength": 1 },
        "startUs": { "$ref": "#/$defs/NonNegUs" },
        "endUs": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "kind": { "$ref": "#/$defs/SpanKind" },
        "origin": { "$ref": "#/$defs/Origin" },
        "createdByEventId": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 1 },
        "approval": { "$ref": "#/$defs/Approval" }
      },
      "additionalProperties": false
    },
    "BeatBinding": {
      "type": "object",
      "required": ["anchorRole"],
      "anyOf": [
        { "required": ["soundId"] },
        { "required": ["candidateEventId"] }
      ],
      "properties": {
        "soundId": { "type": "string", "minLength": 1 },
        "candidateEventId": { "type": "string", "minLength": 1 },
        "anchorId": { "type": "string", "minLength": 1 },
        "anchorRole": { "$ref": "#/$defs/SnapRole" },
        "alignmentStale": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "BeatStructural": {
      "type": "object",
      "properties": {
        "downbeat": { "type": "boolean" },
        "phraseReset": { "type": "boolean" },
        "fermata": { "type": "boolean" },
        "anchorKind": { "$ref": "#/$defs/BeatAnchorKind" },
        "groupId": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "Beat": {
      "type": "object",
      "required": ["id", "atUs", "origin", "createdByEventId", "revision"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "atUs": { "$ref": "#/$defs/NonNegUs" },
        "origin": { "$ref": "#/$defs/Origin" },
        "createdByEventId": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "boundTo": { "$ref": "#/$defs/BeatBinding" },
        "structural": { "$ref": "#/$defs/BeatStructural" },
        "lineage": {
          "type": "object",
          "required": ["origin", "atUs"],
          "properties": {
            "origin": { "$ref": "#/$defs/Origin" },
            "atUs": { "$ref": "#/$defs/NonNegUs" },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "additionalProperties": false
        },
        "verdict": { "$ref": "#/$defs/Verdict" }
      },
      "additionalProperties": false
    },
    "Unbeat": {
      "type": "object",
      "required": ["id", "atUs", "origin", "createdByEventId", "revision", "tolUs", "pulseLayer"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "atUs": { "$ref": "#/$defs/NonNegUs" },
        "origin": { "$ref": "#/$defs/Origin" },
        "createdByEventId": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 1 },
        "tolUs": { "$ref": "#/$defs/NonNegUs" },
        "pulseLayer": { "$ref": "#/$defs/PulseLayer" },
        "replaces": {
          "type": "object",
          "required": ["beatId", "origin", "createdByEventId", "priorRevision", "atUs"],
          "properties": {
            "beatId": { "type": "string", "minLength": 1 },
            "origin": { "$ref": "#/$defs/Origin" },
            "createdByEventId": { "type": "string", "minLength": 1 },
            "priorRevision": { "type": "integer", "minimum": 1 },
            "atUs": { "$ref": "#/$defs/NonNegUs" },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "additionalProperties": false
        },
        "verdict": { "$ref": "#/$defs/Verdict" }
      },
      "additionalProperties": false
    },
    "SoundAnchorPoint": {
      "type": "object",
      "required": ["id", "role", "atUs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "role": { "$ref": "#/$defs/SnapRole" },
        "atUs": { "$ref": "#/$defs/NonNegUs" },
        "sigmaUs": { "$ref": "#/$defs/NonNegUs" }
      },
      "additionalProperties": false
    },
    "SoundCharacteristics": {
      "type": "object",
      "properties": {
        "family": { "type": "string", "minLength": 1 },
        "register": { "$ref": "#/$defs/SoundRegister" },
        "f0Hz": { "type": "number", "exclusiveMinimum": 0 },
        "harmonicity": { "type": "number", "minimum": 0, "maximum": 1 },
        "stereoPan": { "type": "number", "minimum": -1, "maximum": 1 },
        "stereoWidth": { "type": "number", "minimum": 0, "maximum": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "Sound": {
      "type": "object",
      "required": ["id", "origin", "createdByEventId", "revision", "startUs", "endUs", "endKind", "anchors", "primaryAnchorId"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "origin": { "$ref": "#/$defs/Origin" },
        "createdByEventId": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 1 },
        "startUs": { "$ref": "#/$defs/NonNegUs" },
        "endUs": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "endKind": { "$ref": "#/$defs/SoundEndKind" },
        "anchors": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/SoundAnchorPoint" }
        },
        "primaryAnchorId": { "type": "string", "minLength": 1 },
        "salience": { "type": "number", "minimum": 0, "maximum": 1 },
        "characteristics": { "$ref": "#/$defs/SoundCharacteristics" },
        "descriptor": {
          "type": "object",
          "required": ["schema", "values"],
          "properties": {
            "schema": { "type": "string", "minLength": 1 },
            "values": { "type": "array", "items": { "type": "number" } }
          },
          "additionalProperties": false
        },
        "voiceGroupId": { "type": "string", "minLength": 1 },
        "classId": { "type": "string", "minLength": 1 },
        "blendStatus": { "$ref": "#/$defs/SoundBlendStatus" },
        "verdict": { "$ref": "#/$defs/Verdict" }
      },
      "additionalProperties": false
    },
    "SoundClass": {
      "type": "object",
      "required": ["id", "origin", "createdByEventId", "revision", "exemplarSoundIds", "matchMode"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "origin": { "$ref": "#/$defs/Origin" },
        "createdByEventId": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 1 },
        "exemplarSoundIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "matchMode": { "$ref": "#/$defs/SoundMatchMode" },
        "label": { "type": "string", "minLength": 1 },
        "verdict": { "$ref": "#/$defs/Verdict" }
      },
      "additionalProperties": false
    },
    "NormalizedIdPair": {
      "type": "array",
      "minItems": 0,
      "maxItems": 2,
      "items": {
        "oneOf": [
          { "type": "null" },
          { "type": "string", "minLength": 1 }
        ]
      }
    },
    "BeatInput": {
      "type": "object",
      "required": ["id", "atUs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "atUs": { "$ref": "#/$defs/NonNegUs" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "boundTo": { "$ref": "#/$defs/BeatBinding" },
        "structural": { "$ref": "#/$defs/BeatStructural" }
      },
      "additionalProperties": false
    },
    "SoundDescriptor": {
      "type": "object",
      "required": ["schema", "values"],
      "properties": {
        "schema": { "type": "string", "minLength": 1 },
        "values": { "type": "array", "items": { "type": "number" } }
      },
      "additionalProperties": false
    },
    "SoundInput": {
      "type": "object",
      "required": ["id", "startUs", "endUs", "anchors"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "startUs": { "$ref": "#/$defs/NonNegUs" },
        "endUs": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "endKind": { "$ref": "#/$defs/SoundEndKind" },
        "anchors": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/SoundAnchorPoint" }
        },
        "primaryAnchorId": { "type": "string", "minLength": 1 },
        "salience": { "type": "number", "minimum": 0, "maximum": 1 },
        "characteristics": { "$ref": "#/$defs/SoundCharacteristics" },
        "descriptor": { "$ref": "#/$defs/SoundDescriptor" },
        "voiceGroupId": { "type": "string", "minLength": 1 },
        "classId": { "type": "string", "minLength": 1 },
        "blendStatus": { "$ref": "#/$defs/SoundBlendStatus" }
      },
      "additionalProperties": false
    },
    "SoundPatch": {
      "type": "object",
      "properties": {
        "startUs": { "$ref": "#/$defs/NonNegUs" },
        "endUs": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "endKind": { "$ref": "#/$defs/SoundEndKind" },
        "anchors": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/SoundAnchorPoint" }
        },
        "primaryAnchorId": { "type": "string", "minLength": 1 },
        "salience": { "type": "number", "minimum": 0, "maximum": 1 },
        "characteristics": { "$ref": "#/$defs/SoundCharacteristics" },
        "descriptor": { "$ref": "#/$defs/SoundDescriptor" },
        "voiceGroupId": { "type": "string", "minLength": 1 },
        "classId": { "type": "string", "minLength": 1 },
        "blendStatus": { "$ref": "#/$defs/SoundBlendStatus" }
      },
      "additionalProperties": false
    },
    "SoundClassInput": {
      "type": "object",
      "required": ["id", "exemplarSoundIds", "matchMode"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "exemplarSoundIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "matchMode": { "$ref": "#/$defs/SoundMatchMode" },
        "label": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
