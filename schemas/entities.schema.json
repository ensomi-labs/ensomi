{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ensomi.dev/schemas/tempo/entities.schema.json",
  "title": "Ensomi Tempo Contract Core Entities",
  "description": "Clock-agnostic source-audio-second entities for Ensomi.",
  "$defs": {
    "EntitySource": {
      "type": "string",
      "enum": ["draft", "user", "offer"]
    },
    "SegmentRegime": {
      "type": "string",
      "enum": ["auto", "free", "break"]
    },
    "SpanKind": {
      "type": "string",
      "enum": ["keep", "free", "inbox"]
    },
    "SpanPriority": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "SnapRole": {
      "type": "string",
      "enum": ["transient_attack", "p_center", "harmonic_change", "release"]
    },
    "SnapFamily": {
      "type": "string",
      "enum": ["percussion", "piano_keys", "strings_winds", "vocal", "bass_synth", "other"]
    },
    "Range": {
      "type": "object",
      "description": "Transient half-open interval [t0, t1) in source-audio seconds (0 <= t0 < t1).",
      "required": ["t0", "t1"],
      "properties": {
        "t0": { "type": "number", "minimum": 0 },
        "t1": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "Segment": {
      "type": "object",
      "description": "Contiguous macro partition segment covering [t0, t1).",
      "required": ["id", "t0", "t1", "regime", "kept", "source", "revision"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "t0": { "type": "number", "minimum": 0 },
        "t1": { "type": "number", "exclusiveMinimum": 0 },
        "regime": { "$ref": "#/$defs/SegmentRegime" },
        "kept": { "type": "boolean" },
        "source": { "$ref": "#/$defs/EntitySource" },
        "revision": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "Span": {
      "type": "object",
      "description": "Child interval strictly inside a single parent Segment (seg.t0 <= span.t0 < span.t1 <= seg.t1).",
      "required": ["id", "segmentId", "t0", "t1", "kind", "source", "revision"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "segmentId": { "type": "string", "minLength": 1 },
        "t0": { "type": "number", "minimum": 0 },
        "t1": { "type": "number", "exclusiveMinimum": 0 },
        "kind": { "$ref": "#/$defs/SpanKind" },
        "priority": { "$ref": "#/$defs/SpanPriority" },
        "reason": { "type": "string" },
        "score": { "type": "number" },
        "source": { "$ref": "#/$defs/EntitySource" },
        "revision": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "Beat": {
      "type": "object",
      "description": "Pulse beat; source === 'user' acts directly as a soft beat guide cue.",
      "required": ["id", "timeSec", "source", "revision"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "timeSec": { "type": "number", "minimum": 0 },
        "source": { "$ref": "#/$defs/EntitySource" },
        "snapEventId": { "type": "string", "minLength": 1 },
        "snapFamily": { "$ref": "#/$defs/SnapFamily" },
        "snapRole": { "$ref": "#/$defs/SnapRole" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "revision": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "SoundAnchor": {
      "type": "object",
      "description": "Acoustic onset anchor; source === 'user' acts directly as a soft sound observation cue.",
      "required": ["id", "timeSec", "source", "revision"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "timeSec": { "type": "number", "minimum": 0 },
        "strength": { "type": "number", "minimum": 0, "maximum": 1 },
        "family": { "$ref": "#/$defs/SnapFamily" },
        "role": { "$ref": "#/$defs/SnapRole" },
        "sigmaMs": { "type": "number", "minimum": 0 },
        "source": { "$ref": "#/$defs/EntitySource" },
        "revision": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "UnbeatCue": {
      "type": "object",
      "description": "Standalone soft repulsion cue marking where no beat should fall.",
      "required": ["id", "timeSec", "source", "revision"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "timeSec": { "type": "number", "minimum": 0 },
        "source": { "const": "user" },
        "revision": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "SnapCandidate": {
      "type": "object",
      "description": "Verifiable micro_assist acoustic snap target.",
      "required": ["eventId", "targetSec", "deltaMs", "family", "role", "label", "salience"],
      "properties": {
        "eventId": { "type": "string", "minLength": 1 },
        "targetSec": { "type": "number", "minimum": 0 },
        "deltaMs": { "type": "number" },
        "family": { "$ref": "#/$defs/SnapFamily" },
        "role": { "$ref": "#/$defs/SnapRole" },
        "sigmaMs": { "type": "number", "minimum": 0 },
        "label": { "type": "string", "minLength": 1 },
        "salience": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "AudioDescriptor": {
      "type": "object",
      "required": ["songId", "durationSec", "clock"],
      "properties": {
        "songId": { "type": "string", "minLength": 1 },
        "durationSec": { "type": "number", "minimum": 0 },
        "sampleRate": { "type": "number", "exclusiveMinimum": 0 },
        "clock": { "type": "string", "minLength": 1 },
        "decoder": { "type": "string" },
        "leadOffsetSec": { "type": "number" }
      },
      "additionalProperties": false
    }
  }
}
