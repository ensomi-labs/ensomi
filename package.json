{
  "name": "ensomi",
  "version": "0.1.0",
  "description": "Zero-dependency ESM contract, epistemic transaction reducer, JCS conformance, and session controller for Ensomi models.",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./testing": {
      "types": "./testing.d.ts",
      "default": "./testing.js"
    },
    "./schemas/*": "./schemas/*",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "testing.js",
    "testing.d.ts",
    "src",
    "schemas",
    "conformance",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://github.com/ensomi-labs/ensomi#readme",
  "bugs": {
    "url": "https://github.com/ensomi-labs/ensomi/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ensomi-labs/ensomi.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  }
}
