<?xml version="1.0" encoding="utf-8"?>
<!-- The recognition session (docs/recognition.md): included in every build. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Sync listens to the room; nothing recorded leaves the device. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- MediaStore: the rows of songs another app downloaded. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <queries>
        <package android:name="com.netease.cloudmusic" />
    </queries>

    <application>
        <activity
            android:name="io.ensomi.android.recognition.ShareActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>

</manifest>
