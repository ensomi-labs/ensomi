    <string name="recognition_failure_no_host_zh">没有安装网易云音乐</string>
    <string name="recognition_failure_no_host_en">NetEase Cloud Music is not installed. A share still continues the session.</string>
    <string name="recognition_failure_launch_zh">网易云音乐打不开</string>
    <string name="recognition_failure_launch_en">NetEase Cloud Music could not be started. Open it by hand; a share continues the session.</string>
    <string name="recognition_failure_recognition_zh">没有识别出这首歌</string>
    <string name="recognition_failure_recognition_en">The song was not recognized. Bring the tablet closer or turn the music up, then try again.</string>
    <string name="recognition_failure_no_right_zh">这首歌没有下载权限</string>
    <string name="recognition_failure_no_right_en">This song cannot be downloaded with this account.</string>
    <string name="recognition_failure_no_share_zh">没有收到分享</string>
    <string name="recognition_failure_no_share_en">No share arrived in time. A share that arrives now still counts.</string>
    <string name="recognition_failure_not_song_zh">分享的不是单曲</string>
    <string name="recognition_failure_not_song_en">What was shared is not a song. Share the song itself.</string>
    <string name="recognition_failure_no_file_zh">文件一直没到</string>
    <string name="recognition_failure_no_file_en">The song\'s file never arrived. If it arrives now it still counts.</string>
    <string name="recognition_failure_protected_zh">这首歌受保护（.ncm）：请改为下载已购买的 MP3</string>
    <string name="recognition_failure_protected_en">This track is protected; download a purchased MP3 instead.</string>
    <string name="recognition_failure_no_model_zh">没有安装谱面模型</string>
    <string name="recognition_failure_no_model_en">The chart model is not installed. Install it from the Library, then try again.</string>
    <string name="recognition_failure_chart_zh">谱面没有生成</string>
    <string name="recognition_failure_chart_en">The chart could not be made.</string>
    <string name="recognition_failure_sync_zh">同步失败</string>
    <string name="recognition_failure_sync_en">Sync failed.</string>
    <string name="recognition_failure_no_lock_zh">同步没有锁定，不会凭猜测加入</string>
    <string name="recognition_failure_no_lock_en">Sync never locked, so the game does not join at a guess. The music in the room may be another recording, such as a live version, or may have stopped.</string>
    <string name="recognition_failure_capture_zh">麦克风不能用</string>
    <string name="recognition_failure_capture_en">The microphone could not be used.</string>
    <string name="recognition_failure_song_ended_zh">歌已经放完了，来不及加入</string>
    <string name="recognition_failure_song_ended_en">The song in the room ended before the game could join.</string>
    <string name="recognition_failure_game_zh">游戏没有开始</string>
    <string name="recognition_failure_game_en">The game could not start.</string>
    <string name="recognition_failure_quit_zh">已退出游戏</string>
    <string name="recognition_failure_quit_en">The game was left. It can join the music again while the song plays.</string>
    <string name="recognition_failure_lost_zh">系统关闭了应用，这次会话丢失了</string>
    <string name="recognition_failure_lost_en">The system closed the app and this session was lost. Start again.</string>
